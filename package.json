{
    "name": "CursorHub",
    "version": "1.1.3",
    "description": "CursorHub - 无感换号工具",
    "main": "./out/main/index.js",
    "author": "fly",
    "build": {
        "appId": "com.cursorhub.app",
        "productName": "CursorHub",
        "mac": {
            "category": "public.app-category.developer-tools",
            "target": [{ "target": "dmg", "arch": ["arm64"] }]
        },
        "win": {
            "target": [{ "target": "nsis", "arch": ["x64"] }]
        },
        "dmg": {
            "title": "CursorHub ${version}"
        },
        "files": [
            "out/**/*",
            "node_modules/**/*"
        ]
    },
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "patch:cursor": "node scripts/patch-cursor.js",
        "patch:cursor:restore": "node scripts/patch-cursor.js --restore",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "npm run build && electron-builder --mac",
        "build:linux": "npm run build && electron-builder --linux",
        "preview": "electron-builder --dir",
        "dev:renderer-only": "vite --config vite.renderer.config.mjs",
        "release": "node scripts/release.js",
        "release:minor": "node scripts/release.js minor",
        "release:major": "node scripts/release.js major"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.1",
        "@electron-toolkit/utils": "^4.0.0",
        "axios": "^1.9.0",
        "better-sqlite3": "^13.0.3",
        "electron-store": "^10.1.0",
        "electron-updater": "^6.3.9",
        "element-plus": "^2.9.11",
        "jwt-decode": "^4.0.0",
        "node-machine-id": "^1.1.12",
        "pinia": "^3.0.3",
        "sql.js": "^1.14.2",
        "sqlite3": "^5.1.7",
        "stream-json": "^1.9.1"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^2.0.0",
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@iconify-json/ep": "^1.2.2",
        "@swc/core": "^1.12.5",
        "@vitejs/plugin-vue": "^5.2.3",
        "chokidar": "^4.0.3",
        "electron-builder": "^26.15.3",
        "electron-vite": "^3.1.0",
        "eslint": "^9.24.0",
        "eslint-plugin-vue": "^10.0.0",
        "glob": "^11.0.3",
        "iconv-lite": "^0.6.3",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "sass": "^1.89.1",
        "unplugin-auto-import": "^19.3.0",
        "unplugin-vue-components": "^28.7.0",
        "vite": "^6.2.6",
        "vite-plugin-javascript-obfuscator": "^3.1.0",
        "vue": "^3.5.13",
        "vue-eslint-parser": "^10.1.3"
    }
}
